---
/* A photograph with AVIF and WebP srcsets, falling back to a plain JPEG.
 * <picture> is display:contents in the stylesheet, so the <img> stays a direct
 * layout child of whatever contains it and the existing CSS still applies. */
import manifest from '../data/images.json';

const { src, alt, sizes = '100vw', style, loading = 'lazy', fetchpriority } = Astro.props;
const entry = manifest[src];

const srcset = (fmt) =>
  entry.variants.filter((v) => v.fmt === fmt).map((v) => `${v.path} ${v.w}w`).join(', ');
---
{entry ? (
  <picture>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
    <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
    <img src={entry.fallback || src} alt={alt} style={style} width={entry.width} height={entry.height}
         loading={loading} decoding="async" fetchpriority={fetchpriority} />
  </picture>
) : (
  <img src={src} alt={alt} style={style} loading={loading} decoding="async" />
)}
